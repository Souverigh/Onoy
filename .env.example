NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local visual preview only. Ignored in production; never enables data access.
ONGOY_PREVIEW=0
# ADRE: фоновое распознавание фото накладных/чеков через Gemini (ТЗ §6).
# Локально — сюда, в .env.local (не в git). На проде (Vercel) — не в файле:
# Vercel → Project → Settings → Environment Variables. Без ключа фото просто
# остаются со статусом "Ошибка" — долг это не блокирует.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Уведомления команде в Telegram (src/lib/telegram.ts): токен от @BotFather и
# номер чата/группы (несколько — через запятую; номер видно в админке →
# «Команда», когда токен уже задан). Без них уведомлений просто нет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Утренняя сводка (Vercel Cron → /api/cron/admin-digest): серверный ключ
# Supabase (Settings → API → service_role) и любой длинный секрет для Cron.
# Только в Vercel → Environment Variables, никогда в код и в git.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
