NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local visual preview only. Ignored in production; never enables data access.
ONGOY_PREVIEW=0
# ADRE: фоновое распознавание фото накладных/чеков через Gemini (ТЗ §6).
# Локально — сюда, в .env.local (не в git). На проде (Vercel) — не в файле:
# Vercel → Project → Settings → Environment Variables. Без ключа фото просто
# остаются со статусом "Ошибка" — долг это не блокирует.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
