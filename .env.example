NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local visual preview only. Ignored in production; never enables data access.
ONGOY_PREVIEW=0
# ADRE (распознавание фото через Gemini, ТЗ §6) работает в Supabase Edge
# Function supabase/functions/recognize-document — GEMINI_API_KEY задаётся
# командой `supabase secrets set` в самом Supabase-проекте, а не здесь.
# Next.js этот ключ не читает и не должен читать.
